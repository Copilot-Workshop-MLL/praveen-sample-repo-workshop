{
  "name": "employee-management",
  "version": "1.0.0",
  "description": "Employee Management System",
  "main": "backend/app.js",
  "scripts": {
    "start": "node backend/app.js",
    "test": "jest --testPathPattern=tests/ --forceExit --runInBand",
    "test:unit": "jest --testPathPattern=tests/unit/ --runInBand",
    "test:integration": "jest --testPathPattern=tests/(auth|employee|dashboard|jwtUtils|middleware)\\.test --forceExit --runInBand",
    "test:coverage": "jest --testPathPattern=tests/ --forceExit --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0",
    "supertest": "^7.0.0"
  }
}
